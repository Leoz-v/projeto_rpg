[
  {
    "id": "alert",
    "name": "Alert",
    "category": "origin",
    "grants": [
      {
        "kind": "feature",
        "feature": {
          "id": "initiative_proficiency",
          "name": "Initiative Proficiency",
          "description": "When you roll Initiative, you can add your Proficiency Bonus to the roll.",
          "effects": [
            {
              "type": "flat_bonus",
              "target": "initiative",
              "value": {
                "proficiency": 1
              }
            }
          ]
        }
      },
      {
        "kind": "feature",
        "feature": {
          "id": "initiative_swap",
          "name": "Initiative Swap",
          "description": "Immediately after you roll Initiative, you can swap your Initiative with the Initiative of one willing ally in the same combat. You can't make this swap if you or the ally has the Incapacitated condition."
        }
      }
    ]
  },
  {
    "id": "magic_initiate_cleric",
    "name": "Magic Initiate (Cleric)",
    "category": "origin",
    "repeatable": true,
    "description": "Repeatable: you must choose a different spell list each time. Spell Change: whenever you gain a new level, you can replace one of the spells you chose for this feat with a different spell of the same level from the chosen spell list.",
