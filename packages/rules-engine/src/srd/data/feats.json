        "options": {
          "pick": "ability",
          "from": [
            "int",
            "wis",
            "cha"
          ]
        }
      },
      {
        "kind": "choice",
        "id": "cantrips",
        "count": 2,
        "options": {
          "pick": "spell",
          "lists": [
            "cleric"
          ],
          "maxLevel": 0,
          "grantAs": {
            "ability": {
              "choice": "spellcasting_ability"
            },
            "uses": "at_will"
          }
        }
      },
      {
        "kind": "choice",
        "id": "level_1_spell",
        "count": 1,
        "options": {
          "pick": "spell",
          "lists": [
            "cleric"
          ],
          "minLevel": 1,
          "maxLevel": 1,
          "grantAs": {
            "ability": {
              "choice": "spellcasting_ability"
            },
            "uses": {
              "per": "long_rest",
              "count": 1,
              "slots": true
            }
          }
        }
      }
    ]
  },
