[
  {
    "id": "champion",
    "classId": "fighter",
    "name": "Champion",
    "levels": [
      {
        "level": 3,
        "grants": [
          {
            "kind": "feature",
            "feature": {
              "id": "improved_critical",
              "name": "Improved Critical",
              "description": "Your attack rolls with weapons and Unarmed Strikes can score a Critical Hit on a roll of 19 or 20 on the d20."
            }
          },
          {
            "kind": "feature",
            "feature": {
              "id": "remarkable_athlete",
              "name": "Remarkable Athlete",
              "description": "You have Advantage on Initiative rolls and Strength (Athletics) checks. In addition, immediately after you score a Critical Hit, you can move up to half your Speed without provoking Opportunity Attacks.",
              "effects": [
                {
                  "type": "advantage",
                  "target": "initiative"
                },
                {
                  "type": "advantage",
                  "target": "skill.athletics"
                }
              ]
            }
          }
        ]
      },
      {
        "level": 7,
        "grants": [
          {
            "kind": "choice",
            "id": "additional_fighting_style",
            "count": 1,
            "options": {
              "pick": "feat",
              "categories": [
                "fighting_style"
              ]
            }
          }
        ]
      },
      {
        "level": 10,
        "grants": [
          {
            "kind": "feature",
            "feature": {
              "id": "heroic_warrior",
              "name": "Heroic Warrior",
              "description": "During combat, you can give yourself Heroic Inspiration whenever you start your turn without it."
            }
          }
        ]
      },
      {
        "level": 15,
        "grants": [
          {
            "kind": "feature",
            "feature": {
              "id": "superior_critical",
              "name": "Superior Critical",
              "description": "Your attack rolls with weapons and Unarmed Strikes can now score a Critical Hit on a roll of 18-20 on the d20."
            }
          }
        ]
      },
      {
        "level": 18,
        "grants": [
          {
            "kind": "feature",
            "feature": {
              "id": "survivor",
              "name": "Survivor",
              "description": "Defy Death. You have Advantage on Death Saving Throws. Moreover, when you roll 18-20 on a Death Saving Throw, you gain the benefit of rolling a 20 on it. Heroic Rally. At the start of each of your turns, you regain Hit Points equal to 5 plus your Constitution modifier if you are Bloodied and have at least 1 Hit Point."
            }
          }
        ]
      }
    ]
  },
  {
    "id": "evoker",
    "classId": "wizard",
    "name": "Evoker",
    "levels": [
      {
        "level": 3,
        "grants": [
          {
            "kind": "choice",
            "id": "evocation_savant",
